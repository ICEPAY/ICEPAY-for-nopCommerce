<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <NopCommerceRoot Condition="'$(NopCommerceRoot)' == ''">$(MSBuildThisFileDirectory).deps/nopCommerce/src</NopCommerceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Nop.Services.Helpers" />
  </ItemGroup>
</Project>
